# Committed defaults for machines without an untracked backend/.env (including CI).
# Local development keeps using backend/.env, which points at PostgreSQL on 127.0.0.1:5433.
# Do not put production secrets in this file.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_not_for_production
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://app:historic@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/auth ###
# Local and CI may use the dev token. Production sets AUTH_DEV_MODE=0 and refuses it.
AUTH_DEV_MODE=1
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
AUTH0_GROUPS_CLAIM=https://historic-winterthur.ch/groups
DEV_USER_NAME="Demo Mitglied"
DEV_USER_GROUPS="admin,Mitglieder,Fahrtenplanung,Gastro-Team,Technische Kommission"
DEV_USER_CLUBS="historic,supporter"
# Leer oder nicht gesetzt: der Demo-Benutzer hat keine Spond-Verknüpfung.
DEV_USER_SPOND_ID=
###< app/auth ###
