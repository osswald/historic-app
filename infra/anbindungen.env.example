# Werte bleiben in dieser Datei, nicht im Chat und nicht in Git.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
# Aufgaben-App. Bearer-Schlüssel ist TASKS_API_TOKEN, ersatzweise TASKS_API_KEY.
# TASKS_API_BASE endet auf /functions/v1 oder /functions/v1/api/v1.
TASKS_API_BASE=
TASKS_API_TOKEN=
TASKS_API_KEY=
# Helferplanung. Basis endet auf /api/public/v1 oder /api/v1. Bearer ist HELFER_API_KEY, ersatzweise HELFER_API_TOKEN.
HELFER_API_BASE=
HELFER_API_TOKEN=
HELFER_API_KEY=
LOG_API_BASE=
LOG_API_TOKEN=
WORDPRESS_BASE=
WORDPRESS_USER=
WORDPRESS_APP_PASSWORD=
RESERVATIONS_API_BASE=
RESERVATIONS_API_TOKEN=
RENT_API_BASE=
RENT_API_TOKEN=
RANGIER_API_BASE=
RANGIER_API_TOKEN=
CASHCTRL_BASE=
CASHCTRL_TOKEN=
# Nextcloud. Basis ist die https-Adresse der Installation, ohne Benutzerdaten in der URL.
# NEXTCLOUD_APP_PASSWORD ist ein App-Passwort. Die App legt keine Freigaben an.
NEXTCLOUD_BASE=
NEXTCLOUD_USER=
NEXTCLOUD_APP_PASSWORD=
SPOND_EXPORT_PATH=
DIDOK_API_BASE=
PUSH_KEY=
SPOND_USERNAME=
SPOND_PASSWORD=
